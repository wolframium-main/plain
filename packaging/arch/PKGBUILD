# Builds plain from this source tree:
#   cd packaging/arch && makepkg -si

pkgname=plain
pkgver=0.1.0
pkgrel=4
pkgdesc='A browser that does exactly what you tell it'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-webengine' 'ttf-ibm-plex' 'hicolor-icon-theme')
makedepends=('cmake')
optdepends=('xdg-utils: open downloaded PDFs in the system viewer')

_srctree="$(realpath "$startdir/../..")"

build() {
  cmake -S "$_srctree" -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
